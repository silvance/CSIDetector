CONFIG_LWIP_IPV4=y
CONFIG_LWIP_IPV6=n
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_INIT=n

# ESP-NOW does not need an association, so STA mode with no AP is fine.
CONFIG_ESP_WIFI_ENABLE_WPA3_SAE=n

# Console: UART0 primary (so boards with only a USB-UART bridge — e.g.
# bare WROOM-1U dev boards — show app logs on /dev/ttyUSBx) plus the
# native USB-Serial-JTAG as a secondary mirror (so boards with native
# USB-CDC also still show logs on /dev/ttyACMx). Either port works.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_USB_SERIAL_JTAG=y

# Partition table with the csi_cfg partition the setup app writes the
# board's settings into (components/csi_settings). Prebuilt images are
# built by scripts/build_firmware.py; reproducible so a rebuild of
# unchanged sources gives the same binaries.
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="../partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_2MB=y
CONFIG_APP_REPRODUCIBLE_BUILD=y
