# systemd timer: tick the hotspot watchdog every 30 s.
#
# AccuracySec=5s tells systemd it can batch this tick within a 5 s window
# of other scheduled work — saves wakeups on a laptop without meaningfully
# slowing the watchdog.

[Unit]
Description=Tick the CSIDetector hotspot watchdog every 30 s

[Timer]
OnBootSec=30s
OnUnitActiveSec=30s
AccuracySec=5s
Unit=csidetector-hotspot.service

[Install]
WantedBy=timers.target
